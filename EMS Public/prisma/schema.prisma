generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  coordinator
}

enum Status {
  active
  inactive
}

enum EventStatus {
  draft
  published
  archived
}

enum RegistrationStatus {
  pending
  approved
  rejected
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  fullName    String   @map("full_name")
  email       String   @unique
  phone       String
  role        Role     @default(coordinator)
  status      Status   @default(active)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events        Event[]        @relation("CreatedBy")
  registrations Registration[] @relation("CoordinatorRegistrations")

  @@map("users")
}

model Event {
  id                   String      @id @default(uuid())
  title                String
  description          String      @db.Text
  department           String?     @default("Computer Science & Engineering")
  eventScope           String?     @default("National") @map("event_scope")
  eventType            String?     @default("Competition") @map("event_type")
  bannerUrl            String?     @map("banner_url")
  eventDate            String      @map("event_date")
  startTime            String      @map("start_time")
  endTime              String      @map("end_time")
  registrationDeadline String      @map("registration_deadline")
  venue                String
  registrationFee      Float       @default(0.0) @map("registration_fee")
  maxTeamSize          Int         @default(1) @map("max_team_size")
  whatsappGroupLink    String?     @map("whatsapp_group_link")
  upiId                String?     @map("upi_id")
  accountHolderName    String?     @map("account_holder_name")
  upiQrUrl             String?     @map("upi_qr_url")
  status               EventStatus @default(draft)
  createdById          String      @map("created_by")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  createdBy     User             @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  organizers    EventOrganizer[]
  registrations Registration[]

  @@index([eventScope])
  @@index([eventType])
  @@map("events")
}

model EventOrganizer {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  name           String
  department     String
  email          String
  phone          String
  registerNumber String?  @map("register_number")
  createdAt      DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_organizers")
}

model Registration {
  id                   String             @id @default(uuid())
  eventId              String             @map("event_id")
  coordinatorId        String?            @map("coordinator_id")
  teamLeaderName       String             @map("team_leader_name")
  teamLeaderEmail      String             @map("team_leader_email")
  teamLeaderPhone      String             @map("team_leader_phone")
  college              String
  department           String
  teamSize             Int                @default(1) @map("team_size")
  paymentScreenshotUrl String             @map("payment_screenshot_url")
  status               RegistrationStatus @default(pending)
  remarks              String?            @db.Text
  registrationDate     DateTime           @default(now()) @map("registration_date")
  createdAt            DateTime           @default(now()) @map("created_at")

  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coordinator User?                @relation("CoordinatorRegistrations", fields: [coordinatorId], references: [id], onDelete: SetNull)
  members     RegistrationMember[]

  @@map("registrations")
}

model RegistrationMember {
  id             String   @id @default(uuid())
  registrationId String   @map("registration_id")
  name           String
  email          String
  phone          String
  registerNumber String?  @map("register_number")
  department     String
  createdAt      DateTime @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("registration_members")
}
